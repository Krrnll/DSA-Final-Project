def fibonacci_sequence(n):
    sequence = []
    a, b = 0, 1
    for _ in range(n):
        sequence.append(a)
        a, b = b, a + b
    return sequence

def main():
    term = int(input("Enter the term number to end the Fibonacci sequence: "))
    if term <= 0:
        print("Please enter a positive integer.")
        return
    sequence = fibonacci_sequence(term)
    print(f"Fibonacci sequence up to term {term}:")
    print(", ".join(map(str, sequence)))

if __name__ == "__main__":
    main()
